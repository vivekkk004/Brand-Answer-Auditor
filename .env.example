# Copy to .env and fill in. Never commit .env.
# Empty values are treated as "not set".

# PostgreSQL in production; SQLite is fine for local experiments.
DATABASE_URL=postgresql+psycopg://auditor:auditor@localhost:5432/auditor
# DATABASE_URL=sqlite:///./auditor.db

# Provider API keys (only the provider you use needs one).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Verification agent. No default model ID: set it explicitly.
VERIFIER_PROVIDER=
VERIFIER_MODEL=

# The models that write the audited answers, one per provider. No defaults.
GEMINI_ANSWER_MODEL=
OPENAI_ANSWER_MODEL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
AGENT_MAX_TURNS=4
# A number, or "none" to not send a temperature at all (some models reject it).
LLM_TEMPERATURE=0

# Optional, in USD per 1 million tokens. If unset, cost is reported as null.
INPUT_TOKEN_PRICE_PER_MILLION=
OUTPUT_TOKEN_PRICE_PER_MILLION=

# Worker: poll interval, and when a running run with no heartbeat is requeued.
WORKER_POLL_SECONDS=5
STALE_RUN_SECONDS=900

LOG_LEVEL=INFO
